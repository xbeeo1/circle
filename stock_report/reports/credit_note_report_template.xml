<odoo>
    <template id="report_credit_note_template">
        <t t-foreach="docs" t-as="o">
            <t t-call="web.basic_layout">
                <div class="container" style="font-family: 'Verdana';">
                    <table style="width:100%; height: 1000px; border-collapse: collapse;" >
                        <thead>
                            <!-- Header (Repeats on every page) -->
                            <tr>
                                <th colspan="10" style="padding:0;border-left: solid 1px transparent;border-top: solid 1px transparent;border-right: solid 1px transparent;">
                                    <div class="text-center">
                                        <h2 class="font-weight-bold">
                                            Circle International Trading Company
                                        </h2>
                                        <h3  class="font-weight-bold">HEAVY MACHINERY PARTS</h3>
                                        <h3 class="font-weight-bold">CREDIT NOTE</h3>
                                    </div>
                                    <div style="text-align: left; font-weight: bold;">
                                        CUSTOMER:
                                    </div>
                                    <div class="row  p-0 container" >
                                        <div class="col-9 border" style="text-align: left;">
                                            <p class="mb-2 mt-2" style="font-weight:bold;">
                                                <t t-esc="o.partner_id.name"/>
                                                <t t-esc="o.partner_id.phone"/>
                                            </p>
                                            <p class="mb-2 mt-2">
                                                <t t-esc="o.partner_id.contact_address_complete"/>
                                            </p>
                                        </div>
                                        <div class="col-3  p-1" style="border: 1px solid black; border-style: solid solid solid none;text-align: left;">
                                            <p class="mb-2 mt-2">
                                                <b>NO:-</b>
                                                <t t-esc="o.name"/>
                                            </p>
                                            <p class="mb-2">
                                                <strong>DATE:-</strong>
                                                <t t-esc="o.invoice_date.strftime('%d/%m/%Y')"/>
                                            </p>
                                        </div>
                                    </div>
                                </th>
                            </tr>
                            <tr>
                                <th class="text-center" style="padding:5px;font-weight:bold;">Sr. #</th>
                                <th class="text-center" style="padding:5px;width:40%; font-weight:bold;">PARTICULARS</th>
                                <th class="text-center" style="padding:5px;font-weight:bold;">QNTY</th>
                                <th class="text-center" style="padding:5px;font-weight:bold;">PRICE</th>
                                <th class="text-center" style="padding:5px;font-weight:bold;">AMOUNT</th>
                                <th class="text-center" style="padding:5px;font-weight:bold;">DIS.</th>
                                <th class="text-center" style="padding:5px;font-weight:bold;">NET AMT</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-set="sr" t-value="1"/>
                            <t t-set="total_amount" t-value="0"/>
                            <t t-set="disc_amount" t-value="0"/>
                            <t t-set="total_amt" t-value="0"/>
                            <t t-foreach="o.line_ids" t-as="line">
                                <t t-if="line.product_id">
                                    <tr style="height:15px;">
                                        <td class="text-center"
                                            style="padding:5px;border-bottom: solid 1px transparent;">
                                            <span t-esc="sr"/>
                                        </td>
                                        <td style="border-bottom: 1px solid transparent; padding:5px; width:40%;">
                                            <t t-esc="line.product_id.default_code"/>

                                            <t t-esc="line.product_id.name"/>

                                            <t t-esc="line.product_id.product_brand_id.name"/>
                                        </td>
                                        <td class="text-center mb-0"
                                            style="padding:5px;border-bottom: solid 1px transparent;">
                                            <t t-esc="line.quantity"/>
                                        </td>
                                        <td class="text-center mb-0"
                                            style="text-align: right;padding:5px;border-bottom: solid 1px transparent">
                                            <t t-esc="line.price_unit"/>
                                        </td>
                                        <td class="text-right mb-0"
                                            style="text-align: right;padding:5px;border-bottom: solid 1px transparent">
                                            <t t-esc="line.quantity*line.price_unit"/>
                                        </td>
                                        <td class="text-right mb-0"
                                            style="text-align: right;padding:5px;border-bottom: solid 1px transparent">
                                            <t t-esc="line.discount_amount"/>

                                        </td>
                                        <td class="text-right mb-0"
                                            style="text-align: right;padding:5px;border-bottom: solid 1px transparent">
                                            <t t-esc="line.price_subtotal"/>
                                        </td>
                                    </tr>
                                </t>
                                <t t-set="sr" t-value="sr + 1"/>
                                <t t-set="total_amt" t-value="total_amt + (line.quantity*line.price_unit)"/>
                                <t t-set="total_amount" t-value="total_amount + line.price_subtotal"/>
                                <t t-set="disc_amount" t-value="disc_amount + line.discount_amount"/>
                            </t>
                            <tr>
                                <td style="border-top:1px solid black; padding:0;"></td>
                                <td style="border-top:1px solid black; padding:0;"></td>
                                <td style="border-top:1px solid black; padding:0;"></td>
                                <td style="border-top:1px solid black; padding:0;"></td>
                                <td style="border-top:1px solid black; padding:0;"></td>
                                <td style="border-top:1px solid black; padding:0;"></td>
                                <td style="border-top:1px solid black; padding:0;"></td>
                            </tr>
                            <tr style="height:25px;" >
                                <td class="border text-end" colspan="4"
                                    style="font-weight: bold;">
                                    Total:-
                                </td>
                                <td  style="text-align: right;border: 1px solid black;">
                                    <t t-esc="'{:,.1f}'.format(total_amt)"/>
                                </td>
                                <td  style="text-align: right;border: 1px solid black;">
                                    <t t-esc="'{:,.1f}'.format(disc_amount)"/>
                                </td>

                                <td style="text-align: right;border: 1px solid black;">
                                    <t t-esc="'{:,.1f}'.format(total_amount)"/>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                    <div class="">
                        Printed On:
                        <t t-esc="context_timestamp(datetime.datetime.now()).strftime('%d/%m/%Y %I:%M:%S %p')"/>
                    </div>

                    <br/>
                    <br/>
                    <br/>
                    <br/>
                    <br/>
                    <div class="row">
                        <div class="col-4">
                            <strong>PREPARED BY</strong>
                        </div>
                        <div class="col-1"/>
                        <div class="col-3">
                            <strong>CHECKED BY</strong>
                        </div>

                        <div class="col-1"/>
                        <div class="col-3 text-end">
                            <strong>AUTHORIZED BY</strong>
                        </div>
                    </div>
                </div>
            </t>
        </t>
    </template>
</odoo>
