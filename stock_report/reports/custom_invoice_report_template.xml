<odoo>
    <template id="customer_invoice_report_template">
        <t t-foreach="docs" t-as="o">
            <t t-call="web.basic_layout">
                <div class="container" style="font-family: 'Verdana';">
                    <table style="width:100%; height: 700px; border-collapse: collapse;">
                        <thead>
                            <!-- Header (Repeats on every page) -->
                            <tr>
                                <th colspan="10"
                                    style="padding:0;border-left: solid 1px transparent;border-top: solid 1px transparent;border-right: solid 1px transparent;">
                                    <div class="text-center">
                                        <h2 class="font-weight-bold">
                                            Circle Autos
                                        </h2>
                                    </div>
                                    <div style="text-align: left; font-weight: bold;">
                                        CUSTOMER:
                                    </div>
                                    <div class="row  p-0 container ">
                                        <div class="col-9 border p-1" style="text-align: left;">
                                            <p class="mb-1 mt-2" style="font-weight:bold;">
                                                <t t-esc="o.partner_id.name"/>
                                            </p>

                                            <p class="mb-1">
                                                <t t-esc="o.partner_id.cnic"/>
                                                |
                                                <t t-esc="o.partner_id.phone"/>
                                                |
                                                <t t-esc="o.partner_id.district"/>
                                                |
                                                <t t-esc="o.partner_id.city"/>
                                            </p>

                                            <p class="mb-2 mt-2">
                                                <t t-set="partner" t-value="o.partner_id"/>
                                                <t t-if="partner.street">
                                                    <span t-esc="partner.street"/>,
                                                </t>

                                                <t t-if="partner.street2">
                                                    <span t-esc="partner.street2"/>,
                                                </t>

                                                <t t-if="partner.zip">
                                                    <span t-esc="partner.zip"/>,
                                                </t>

                                                <t t-if="partner.city">
                                                    <span t-esc="partner.city"/>,
                                                </t>

                                                <t t-if="partner.state_id">
                                                    <span t-esc="partner.state_id.name"/>,
                                                </t>

                                                <t t-if="partner.country_id">
                                                    <span t-esc="partner.country_id.name"/>
                                                </t>
                                                <!-- <t t-esc="o.partner_id.contact_address_complete"/> -->
                                            </p>


                                        </div>
                                        <div class="col-3  p-1"
                                             style="border: 1px solid black; border-style: solid solid solid none;text-align: left;">
                                            <p class="mb-2 mt-2">
                                                <b>NO:-</b>
                                                <t t-esc="o.invoice_number"/>
                                            </p>
                                            <p class="mb-2">
                                                <strong>DATE:-</strong>
                                                <t t-if="o.invoice_date">
                                                    <t t-esc="o.invoice_date.strftime('%d/%m/%Y')"/>
                                                </t>
                                            </p>
                                            <p class="mb-2 mt-2">
                                                <strong>Salesperson:</strong>
                                                <t t-esc="o.user_id.name"/>
                                            </p>
                                        </div>
                                    </div>
                                </th>
                            </tr>
                            <tr>
                                <th class="text-center" style="padding:5px;font-weight:bold;">Sr#</th>
                                <th class="text-center" style="padding:5px;width:40%; font-weight:bold;">PARTICULARS
                                </th>
                                <th class="text-center" style="padding:5px;font-weight:bold;">QTY</th>
                                <th class="text-center" style="padding:5px;font-weight:bold; ">Rate</th>
                                <th class="text-center" style="padding:5px;font-weight:bold; ">Amount</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-set="sr" t-value="1"/>
                            <t t-set="total_amount" t-value="0"/>

                            <t t-foreach="o.line_ids" t-as="line">
                                <t t-if="line.product_id">
                                    <tr style="height:25px;">
                                        <td class="text-center"
                                            style="padding:5px;border-bottom: solid 1px transparent;">
                                            <span t-esc="sr"/>
                                        </td>
                                        <td style="border-bottom: 1px solid transparent; padding:5px; width:40%;">
                                            <t t-esc="line.product_id.default_code"/>

                                            <t t-esc="line.product_id.name"/>

                                            <t t-esc="line.product_id.product_brand_id.name"/>
                                        </td>
                                        <td class="text-center mb-0"
                                            style="padding:5px;border-bottom: solid 1px transparent;">
                                            <t t-esc="line.quantity"/>
                                        </td>
                                        <td
                                                style="text-align: right;padding:5px;border-bottom: solid 1px transparent;">
                                            <t t-esc="line.price_unit"/>
                                        </td>
                                        <td
                                                style="text-align: right;padding:5px;border-bottom: solid 1px transparent;">
                                            <t t-esc="line.quantity*line.price_unit"/>
                                        </td>
                                    </tr>
                                </t>
                                <t t-set="sr" t-value="sr + 1"/>
                                <t t-set="total_amount" t-value="total_amount + (line.quantity*line.price_unit)"/>
                            </t>
                            <tr>
                                <td style="border-top:1px solid black; padding:0;"></td>
                                <td style="border-top:1px solid black; padding:0;"></td>
                                <td style="border-top:1px solid black; padding:0;"></td>
                                <td style="border-top:1px solid black; padding:0;"></td>
                                <td style="border-top:1px solid black; padding:0;"></td>

                            </tr>
                            <tr style="height:25px;">
                                <td class="border text-end" colspan="4"
                                    style="padding-right: 20px; ">
                                    <b>TOTAL</b>------------------------------------------>
                                </td>
                                <td class="text-right" style="text-align: right;border: 1px solid black;">
                                    <t t-esc="'{:,.1f}'.format(total_amount)"/>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                    <div class="">
                        <strong>Ledger Balance:</strong>
                        <t t-esc="'{:,.1f}'.format(o.ledger_balance)"/>
                    </div>
                    <div class="row mt-5">
                        <table class="table table-border">
                            <tr style="font-weight: bold;">

                                <td class="text-start border border-top-0 ">
                                    <t t-esc="o.currency_id.amount_to_text(total_amount)"/>
                                </td>
                            </tr>
                        </table>
                    </div>
                    <div class="d-flex  mt-4" style="font-size:10px">
                        <div class="text-center mt-4" style="margin-right: 15px;font-size:14px">
                            <strong>Balance Aging (Days)</strong>
                        </div>
                        <div class="text-center" style="margin-right: 15px; width: 12%;">
                            <div class="category-label mb-1" style="font-weight: bold;">0-30</div>
                            <div class="category-box border p-1" style="height: 30px;">
                                <t t-esc="o.amount_0_30"/>
                            </div>
                        </div>
                        <div class="text-center" style="margin-right: 15px; width: 12%;">
                            <div class="category-label mb-1" style="font-weight: bold;">31-60</div>
                            <div class="category-box border p-1" style="height: 30px;">
                                <t t-esc="o.amount_31_60"/>
                            </div>
                        </div>
                        <div class="text-center" style="margin-right: 15px; width: 12%;">
                            <div class="category-label mb-1" style="font-weight: bold;">61-90</div>
                            <div class="category-box border p-1" style="height: 30px;">
                                <t t-esc="o.amount_61_90"/>
                            </div>
                        </div>
                        <div class="text-center" style="margin-right: 15px; width: 12%;">
                            <div class="category-label mb-1" style="font-weight: bold;">90-120</div>
                            <div class="category-box border p-1" style="height: 30px;">
                                <t t-esc="o.amount_90_120"/>
                            </div>
                        </div>
                        <div class="text-center" style="width: 12%;">
                            <div class="category-label mb-1" style="font-weight: bold;">120+</div>
                            <div class="category-box border p-1" style="height: 30px;">
                                <t t-esc="o.amount_120_plus"/>
                            </div>
                        </div>
                    </div>
                    <br/>
                    <br/>
                    <br/>
                    <br/>
                    <br/>
                    <div class="row">
                        <div class="col-4 border-top text-center">
                            <strong>PREPARED BY</strong>
                        </div>
                        <div class="col-1"/>
                        <div class="col-3 border-top text-center">
                            <strong>CHECKED BY</strong>
                        </div>

                        <div class="col-1"/>
                        <div class="col-3 border-top text-center">
                            <strong>AUTHORIZED BY</strong>
                        </div>
                    </div>
                </div>
            </t>
        </t>
    </template>
</odoo>
