<odoo>
    <template id="report_payment_receipt_document_inherit"
              inherit_id="account.report_payment_receipt_document">

        <xpath expr="//div[@class='row'][.//span[@t-field='o.partner_id']]/div[@class='col-6'][1]"
               position="inside">

            <div t-if="o.ref_by" style="font-size: 15px;">
                Ref By: <span t-field="o.ref_by"/>
            </div>

        </xpath>

    </template>
</odoo>