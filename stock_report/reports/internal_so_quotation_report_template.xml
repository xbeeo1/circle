<odoo>
    <template id="internal_quotation_report_template">
        <t t-foreach="docs" t-as="o">
            <t t-call="web.basic_layout">
                <div class="container" style="font-family: 'Verdana';">
                    <table style="width:100%; height: 1000px; border-collapse: collapse;">
                        <thead>
                            <!-- Header -->
                            <tr>
                                <th colspan="10"
                                    style="padding:0;border-left:1px solid transparent;border-top:1px solid transparent;border-right:1px solid transparent;">
                                    <div class="text-center">
                                        <h2 class="font-weight-bold">
                                            Circle International Trading Company
                                        </h2>
                                        <h4 class="mb-0">HEAVY MACHINERY PARTS</h4>
                                        <p class="mb-0">MULTAN ROAD, CHUNG, LAHORE</p>
                                        <p class="mb-0">
                                            ACCOUNTS@CIRCLE.COM
                                        </p>
                                        <h3 class="">QUOTATION</h3>
                                    </div>
                                    <div class="row  p-0 container col-12">
                                        <div class="col-9 border p-1" style="text-align: left;">
                                            <p class="mb-1 mt-2" style="font-weight:bold;">
                                                <strong>M/S:</strong>
                                                <t t-esc="o.partner_id.name"/>
                                            </p>

                                            <p class="mb-1">
                                                <t t-esc="o.partner_id.cnic"/>
                                                |
                                                <t t-esc="o.partner_id.phone"/>
                                                |
                                                <t t-esc="o.partner_id.district"/>
                                                |
                                                <t t-esc="o.partner_id.city"/>
                                            </p>

                                            <p class="mb-2 mt-2">
                                                <t t-set="partner" t-value="o.partner_id"/>
                                                <t t-if="partner.street">
                                                    <span t-esc="partner.street"/>,
                                                </t>

                                                <t t-if="partner.street2">
                                                    <span t-esc="partner.street2"/>,
                                                </t>

                                                <t t-if="partner.zip">
                                                    <span t-esc="partner.zip"/>,
                                                </t>

                                                <t t-if="partner.city">
                                                    <span t-esc="partner.city"/>,
                                                </t>

                                                <t t-if="partner.state_id">
                                                    <span t-esc="partner.state_id.name"/>,
                                                </t>

                                                <t t-if="partner.country_id">
                                                    <span t-esc="partner.country_id.name"/>
                                                </t>
                                                <!-- <t t-esc="o.partner_id.contact_address_complete"/>-->
                                            </p>


                                        </div>
                                        <div class="col-3  p-1"
                                             style="border: 1px solid black; border-style: solid solid solid none;text-align: left;">
                                            <p class="mb-2 mt-2">
                                                <b>Qtn#:</b>
                                                <t t-esc="o.name"/>
                                            </p>
                                            <p class="mb-2">
                                                <strong>Dated:</strong>
                                                <t t-esc="o.date_order.strftime('%d/%m/%Y')"/>
                                            </p>
                                            <p class="mb-2">
                                                <strong>Expiry:</strong>
                                                <t t-esc="o.validity_date.strftime('%d/%m/%Y')"/>
                                            </p>
                                            <p class="mb-2 mt-2">
                                                <strong>Salesperson:</strong>
                                                <t t-esc="o.user_id.name"/>
                                            </p>
                                        </div>
                                    </div>
                                </th>
                            </tr>
                            <tr>
                                <th class="text-center" style="padding:5px;font-weight:bold;">Sr#</th>
                                <th class="text-center" style="padding:5px;width:40%; font-weight:bold;">ITEM NAME</th>
                                <th class="text-center" style="padding:5px;font-weight:bold;">STOCK</th>
                                <th class="text-center" style="padding:5px;font-weight:bold;">QNTY</th>
                                <th class="text-center" style="padding:5px;font-weight:bold;">Unit</th>
                                <th class="text-center" style="padding:5px;font-weight:bold;">Rate</th>
                                <th class="text-center" style="padding:5px;font-weight:bold;">Amount</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-set="sr" t-value="1"/>
                            <t t-set="total_amount" t-value="0"/>
                            <t t-set="total_qty" t-value="0"/>
                            <t t-foreach="o.order_line" t-as="line">
                                <tr style="height:25px;">
                                    <td class="text-center"
                                        style="padding:5px;border-bottom:1px solid transparent;">
                                        <span t-esc="sr"/>
                                    </td>
                                    <td style="padding:5px;border-bottom:1px solid transparent;">
                                        <t t-esc="line.product_id.default_code"/>

                                        <t t-esc="line.product_id.name"/>

                                        <t t-esc="line.product_id.product_brand_id.name"/>
                                    </td>
                                    <td class="text-center mb-0"
                                        style="padding:5px;border-bottom:1px solid transparent;">
                                        <t t-esc="line.product_id.qty_available "/>
                                    </td>
                                    <td class="text-center mb-0"
                                        style="padding:5px;border-bottom:1px solid transparent;">
                                        <t t-esc="line.product_uom_qty"/>
                                        <t t-set="total_qty" t-value="total_qty + line.product_uom_qty"/>
                                    </td>
                                    <td class="text-center mb-0"
                                        style="padding:5px;border-bottom:1px solid transparent;">
                                        <t t-esc="line.product_uom_id.name"/>
                                    </td>
                                    <td class="text-right mb-0"
                                        style="text-align:right;padding:5px;border-bottom:1px solid transparent;">
                                        <t t-esc="line.price_unit"/>
                                    </td>
                                    <td class="text-right mb-0"
                                        style="text-align:right;padding:5px;border-bottom:1px solid transparent;">
                                        <t t-esc="line.product_uom_qty * line.price_unit"/>
                                    </td>
                                </tr>
                                <t t-set="sr" t-value="sr + 1"/>
                                <t t-set="total_amount"
                                   t-value="total_amount + (line.product_uom_qty * line.price_unit)"/>
                            </t>
                            <tr>
                                <td style="border-top:1px solid black; padding:0;"></td>
                                <td style="border-top:1px solid black; padding:0;"></td>
                                <td style="border-top:1px solid black; padding:0;"></td>
                                <td style="border-top:1px solid black; padding:0;"></td>
                                <td style="border-top:1px solid black; padding:0;"></td>
                                <td style="border-top:1px solid black; padding:0;"></td>
                                <td style="border-top:1px solid black; padding:0;"></td>
                            </tr>
                            <!-- Total Row -->
                            <tr style="height:25px;">
                                <td></td>
                                <td style="text-align:right;padding:5px;font-weight:bold;">Total:-</td>
                                <td></td>
                                <td></td>
                                <td></td>
                                <td></td>
                                <td style="text-align:right;padding:5px;">
                                    <t t-esc="'{:,.1f}'.format(total_amount)"/>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                    <div style="page-break-inside: avoid; margin-top:20px;">
                        <div class="mt-4">
                            <t t-esc="o.note"/>
                        </div>

                        <!-- Signatures -->
                        <br/>
                        <br/>
                        <br/>
                        <div class="row" style="margin-top:30px;">
                            <div class="col-1"></div>
                            <div class="col-3">
                                <strong>Prepared By</strong>
                            </div>
                            <div class="col-3"></div>
                            <div class="col-2"></div>
                            <div class="col-4 text-left">
                                <strong>Authorized Signature</strong>
                            </div>
                        </div>
                    </div>
                </div>
            </t>
        </t>
    </template>
</odoo>
