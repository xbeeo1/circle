<odoo>
    <template id="purchase_order_report_template">
        <t t-foreach="docs" t-as="o">
            <t t-call="web.basic_layout">
                <div class="container" style="font-family: 'Verdana';">

                    <!-- Main Table with Repeating Header -->
                    <table style="width:100%; height: 1000px; border-collapse: collapse;" >
                        <thead>
                            <!-- Header (Repeats on every page) -->
                            <tr>
                                <th colspan="10" style="padding:0;border-left: solid 1px transparent;border-top: solid 1px transparent;border-right: solid 1px transparent;">
                                    <div class="text-center" style="margin-bottom:10px;">
                                        <h2 class="font-weight-bold">Circle International Trading Company</h2>
                                        <h4 class="mb-0">HEAVY MACHINERY PARTS</h4>
                                        <p class="mb-0">MULTAN ROAD, CHUNG, LAHORE</p>
                                        <p class="mb-0">ACCOUNTS@CIRCLE.COM</p>
                                        <h3>PURCHASE ORDER</h3>
                                    </div>

                                    <div class="row p-0 container col-12">
                                        <div class="col-9 border p-1" style="text-align: left;">
                                            <p class="mb-2 mt-2" style="font-weight:bold;">
                                                <strong>M/S:</strong>
                                                <t t-esc="o.partner_id.name"/>
                                                <t t-esc="o.partner_id.phone"/>
                                            </p>
                                            <p class="mb-2 mt-2">
                                                <t t-esc="o.partner_id.contact_address_complete"/>
                                            </p>
                                        </div>
                                        <div class="col-3 p-1" style="border: 1px solid black; border-style: solid solid solid none;text-align: left;">
                                            <p class="mb-2 mt-2">
                                                <b>PO No:</b>
                                                <t t-esc="o.name"/>
                                            </p>
                                            <p class="mb-2">
                                                <strong>Dated:</strong>
                                                <t t-esc="o.date_order.strftime('%d/%m/%Y')"/>
                                            </p>
                                        </div>
                                    </div>
                                </th>
                            </tr>

                            <!-- Table Header (Columns) -->
                            <tr>
                                <th class="text-center" style="padding:5px;font-weight:bold;">Sr#</th>
                                <th class="text-center" style="padding:5px;width:40%; font-weight:bold;">ITEM NAME</th>
                                <th class="text-center" style="padding:5px;font-weight:bold;">QTY</th>
                                <th class="text-center" style="padding:5px;font-weight:bold;">Unit</th>
                                <th class="text-center" style="padding:5px;font-weight:bold; ">Rate</th>
                                <th class="text-center" style="padding:5px;font-weight:bold; ">Amount</th>
                                <th class="text-center" style="padding:5px;font-weight:bold; ">DISC%</th>
                                <th class="text-center" style="padding:5px;font-weight:bold; ">DIS.AMT</th>
                                <th class="text-center" style="padding:5px;font-weight:bold; ">GST.AMT</th>
                                <th class="text-center" style="padding:5px;font-weight:bold; ">TOTAL</th>
                            </tr>
                        </thead>

                        <tbody>
                            <t t-set="sr" t-value="1"/>
                            <t t-set="total_amount" t-value="0"/>
                            <t t-set="disc_amount" t-value="0"/>
                            <t t-set="gst_amount" t-value="0"/>
                            <t t-foreach="o.order_line" t-as="line">
                                <tr style="height:25px;">
                                    <td class="text-center" style="padding:5px;border-bottom: solid 1px transparent;" ><span t-esc="sr"/></td>
                                    <td style="border-bottom: 1px solid transparent; padding:5px; width:40%;">
                                        <div><t t-esc="line.product_id.default_code"/></div>
                                        <div style="word-break: break-all;"><t t-esc="line.product_id.name"/></div>
                                        <div><t t-esc="line.product_id.product_brand_id.name"/></div>
                                    </td>
                                    <td class="text-center" style="padding:5px;border-bottom: solid 1px transparent" ><t t-esc="line.product_uom_qty"/></td>
                                    <td class="text-center" style="padding:5px;border-bottom: solid 1px transparent" ><t t-esc="line.product_uom.name"/></td>
                                    <td  style="text-align: right;padding:5px;border-bottom: solid 1px transparent" ><t t-esc="line.price_unit"/></td>
                                    <td  style="text-align: right;padding:5px;border-bottom: solid 1px transparent" ><t t-esc="line.product_uom_qty * line.price_unit"/></td>
                                    <td  style="text-align: right;padding:5px;border-bottom: solid 1px transparent" ><t t-esc="line.discount"/></td>
                                    <td  style="text-align: right;padding:5px;border-bottom: solid 1px transparent" ><t t-esc="line.discount_amount"/></td>
                                    <td style="text-align: right;padding:5px;border-bottom: solid 1px transparent"><t t-esc="line.gst_amount"/></td>
                                    <td style="text-align: right;padding:5px;border-bottom: solid 1px transparent" ><t t-esc="line.price_subtotal + line.gst_amount"/></td>
                                </tr>
                                <t t-set="total_amount" t-value="total_amount + (line.product_uom_qty * line.price_unit)"/>
                                <t t-set="disc_amount" t-value="disc_amount + line.discount_amount"/>
                                <t t-set="gst_amount" t-value="gst_amount + line.gst_amount"/>
                                <t t-set="sr" t-value="sr + 1"/>
                            </t>
                            <tr>
                                <td style="border-top:1px solid black; padding:0;"></td>
                                <td style="border-top:1px solid black; padding:0;"></td>
                                <td style="border-top:1px solid black; padding:0;"></td>
                                <td style="border-top:1px solid black; padding:0;"></td>
                                <td style="border-top:1px solid black; padding:0;"></td>
                                <td style="border-top:1px solid black; padding:0;"></td>
                                <td style="border-top:1px solid black; padding:0;"></td>
                                <td style="border-top:1px solid black; padding:0;"></td>
                                <td style="border-top:1px solid black; padding:0;"></td>
                                <td style="border-top:1px solid black; padding:0;"></td>
                            </tr>

                            <!-- Totals Row (Only once at the end) -->
                            <tr style="height:25px;">
                                <td style="height:25px;"></td>
                                <td style="height:25px;text-align: right;padding:5px; font-weight:bold;">Total:-</td>
                                <td style="height:25px;"></td>
                                <td style="height:25px;"></td>
                                <td style="height:25px;"></td>
                                <td style="height:25px;text-align: right;padding:5px;"><t t-esc="'{:,.1f}'.format(total_amount)"/></td>
                                <td style="height:25px;"></td>
                                <td style="height:25px;text-align: right; padding:5px;"><t t-esc="'{:,.1f}'.format(disc_amount)"/></td>
                                <td style="height:25px;text-align: right; padding:5px;"><t t-esc="'{:,.1f}'.format(gst_amount)"/></td>
                                <td style="height:25px;text-align: right; padding:5px;"><t t-esc="'{:,.1f}'.format(o.amount_total)"/></td>
                            </tr>
                        </tbody>
                    </table>
                    <div style="page-break-inside: avoid; margin-top:20px;">
                        <!-- Amount in Words -->
                        <table style="width:100%; border-collapse: collapse;">
                            <tr>
                                <td style="border:1px solid black; padding:5px;">
                                    <t t-esc="o.currency_id.amount_to_text(o.amount_total)"/>
                                </td>
                            </tr>
                        </table>

                        <!-- Signature Section -->
                        <br/><br/><br/>
                        <div class="row" style="margin-top:30px;">
                            <div class="col-1"></div>
                            <div class="col-3"><strong>Prepared By</strong></div>
                            <div class="col-3"></div>
                            <div class="col-2"></div>
                            <div class="col-4 text-left"><strong>Authorized Signature</strong></div>
                        </div>
                    </div>

                </div>
            </t>
        </t>
    </template>


</odoo>
