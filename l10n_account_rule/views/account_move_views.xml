<?xml version="1.0" encoding="utf-8"?>

<odoo>
    <data>
        <record id="cl_view_move_form_inherit" model="ir.ui.view">
            <field name="name">account.move.form.inherit.discount.amount</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">

                <xpath expr="//field[@name='invoice_vendor_bill_id']" position="after">
                    <field name="invoice_number" invisible="move_type == 'in_invoice'"/>
                    <field name="bill_number" invisible="move_type == 'out_invoice'"/>
                </xpath>
                <xpath expr="//div[@name='journal_div']" position="after">
                    <field name="partner_credit" invisible="1"/>
                    <field name="partner_debit" invisible="1"/>
                    <field name="partner_current_balance"/>
                </xpath>
                <xpath expr="//field[@name='invoice_user_id']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <xpath expr="//field[@name='partner_current_balance']" position="after">
                    <field name="invoice_user_id" widget="many2one_avatar_user"/>
                </xpath>


                <xpath expr="//field[@name='invoice_line_ids']//list/field[@name='quantity']" position="attributes">
                    <attribute name="sum">Total</attribute>
                </xpath>
                <xpath expr="//field[@name='invoice_line_ids']//list//field[@name='discount']" position="attributes">
                    <attribute name="column_invisible">1</attribute>
                </xpath>
                <xpath expr="//field[@name='invoice_line_ids']//list/field[@name='discount']" position="before">
                    <field name="discount_amount" force_save="1"/>
                </xpath>
            </field>
        </record>


        <record id="cl_view_account_invoice_filter_inherit" model="ir.ui.view">
            <field name="name">account.move.search.inherit</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_account_invoice_filter"/>
            <field name="arch" type="xml">
                <xpath expr="//search/field[@name='name']" position="after">
                    <field name="invoice_number"/>
                    <field name="bill_number"/>
                </xpath>
                <xpath expr="//filter[@name='draft']" position="before">
                    <filter string="Invoice Number" name="invoice_number" domain="[('invoice_number', '!=', False)]"/>
                    <filter string="Bill Number" name="bill_number" domain="[('bill_number', '!=', False)]"/>
                </xpath>
                <xpath expr="//group/filter[@name='status']" position="after">
                    <filter string="Bill Number" name="bill_number" context="{'group_by':'bill_number'}"/>
                </xpath>
            </field>
        </record>


    </data>
</odoo>
