<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_emp_perform_tracking_list" model="ir.ui.view">
            <field name="name">employee.performance.tracking.list</field>
            <field name="model">employee.performance.tracking</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                    <field name="employee_id"/>
                    <field name="department_id"/>
                    <field name="user_id" optional="hide"/>
                    <field name="date_from"/>
                    <field name="date_to"/>
                    <field name="total_invoice_amount" sum="Total"/>
                    <field name="total_expense_amount" sum="Total"/>
                    <field name="total_profit_amount" sum="Total"/>
                    <field name="currency_id" optional="hide"/>
                    <field name="company_id" optional="hide"/>
                </list>
            </field>
        </record>


        <record id="view_emp_perform_tracking_form" model="ir.ui.view">
            <field name="name">employee.performance.tracking.tree</field>
            <field name="model">employee.performance.tracking</field>
            <field name="arch" type="xml">
                <form string="">
                    <sheet>
                        <field name="image_1920" widget="image" class="oe_avatar"/>
                        <div class="oe_title">
                            <h1>
                                <field name="name" readonly="1"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="employee_id" options="{'no_quick_create': True, 'no_create_edit': True}"/>
                                <field name="date_from"/>
                                <field name="user_id" options="{'no_quick_create': True, 'no_create_edit': True}"/>
                            </group>
                            <group>
                                <field name="department_id" options="{'no_quick_create': True, 'no_create_edit': True}"/>
                                <field name="date_to"/>
                                <field name="company_id" invisible="1"/>
                            </group>
                        </group>

                        <group col="3">
                            <group string="Total Expense" name="total_expense_amount">
                                <field name="total_expense_amount"/>
                            </group>

                            <group string="Total Amount" name="total_invoice_amount">
                                <field name="total_invoice_amount"/>
                            </group>

                            <group string="Total Profit" name="total_profit_amount">
                                <field name="total_profit_amount"/>
                            </group>
                        </group>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record id="view_emp_perform_tracking_search" model="ir.ui.view">
            <field name="name">employee.performance.tracking.search</field>
            <field name="model">employee.performance.tracking</field>
            <field name="arch" type="xml">
                <search string="Search Portal">
                    <field name="name"/>
                    <field name="employee_id"/>
                    <field name="department_id"/>
                    <field name="user_id"/>
                    <field name="date_from"/>
                    <field name="date_to"/>
                    <field name="total_expense_amount"/>
                    <field name="total_invoice_amount"/>
                    <field name="total_profit_amount"/>
                    <filter string="Employee" name="employee_id" domain="[('employee_id', '!=', False)]"/>
                    <filter string="Department" name="department_id" domain="[('department_id', '!=', False)]"/>
                    <filter string="Responsible" name="user_id" domain="[('user_id', '!=', False)]"/>
                    <group>
                        <filter string="Employee" name="employee_id" context="{'group_by':'employee_id'}"/>
                        <filter string="Department" name="department_id" context="{'group_by':'department_id'}"/>
                        <filter string="Responsible" name="user_id" context="{'group_by':'user_id'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="action_emp_perform_tracking" model="ir.actions.act_window">
            <field name="name">Employee Performance Tracking</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">employee.performance.tracking</field>
            <field name="view_mode">list,form</field>
            <!--        <field name="view_mode">tree,form,kanban,calendar</field>-->
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create New Employee Performance!
                </p>
            </field>
        </record>

<!--        <menuitem id="menu_sales_portal_root"-->
