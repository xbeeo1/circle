<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_engine_number_tree" model="ir.ui.view">
            <field name="name">engine.number.tree</field>
            <field name="model">engine.number</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                    <field name="description"/>
                </list>
            </field>
        </record>

        <!-- Form view -->
        <record id="view_engine_number_form" model="ir.ui.view">
            <field name="name">engine.number.form</field>
            <field name="model">engine.number</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>

                        <group>
                            <field name="name"/>
                            <field name="description"/>
                        </group>

                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_engine_number" model="ir.actions.act_window">
            <field name="name">Engine Number</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">engine.number</field>
            <field name="view_mode">list,form</field>
            <field name="context">{}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create Your First Engine Number...!
                </p>
            </field>
        </record>

        <menuitem id="menu_engine_number"
                  name="Engine Number"
                  parent="stock.menu_product_in_config_stock"
                  action="action_engine_number"
                  sequence="3"/>

    </data>
</odoo>
