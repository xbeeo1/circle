<odoo>
    <record id="view_purchase_order_form_inherit_discount_amount" model="ir.ui.view">
        <field name="name">purchase.order.form.inherit.discount.amount</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">

            <xpath expr="//div[@name='reminder']" position="after">
                <field name="partner_credit" invisible="1"/>
                <field name="partner_debit" invisible="1"/>
                <field name="partner_current_balance"/>
            </xpath>

            <xpath expr="//field[@name='order_line']//list//field[@name='product_qty']" position="attributes">
                <attribute name="sum">Total</attribute>
            </xpath>
            <xpath expr="//field[@name='order_line']//list//field[@name='discount']" position="attributes">
                <attribute name="optional">hide</attribute>
            </xpath>
            <xpath expr="//field[@name='order_line']//list/field[@name='discount']" position="before">
                <field name="gst_amount" force_save="1"/>
                <field name="discount_amount" force_save="1"/>
            </xpath>

            <xpath expr="//div[hasclass('clearfix')]" position="after">
                <button name="get_product_purchase_history" type="object" data-hotkey="shift+g" string="Purchase History" class="oe_highlight" invisible="not order_line"/>

                <!--RELATED PARTNER PRODUCTS PURCHASE -->
                <group name="overall_purchase" string="CURRENT VENDOR PURCHASE HISTORY" class="mt-1"></group>
                <field name="partner_purchase_history" widget="section_and_note_one2many" readonly="1">
                    <list string="Products Line" editable="bottom">
                        <field name="currency_id" column_invisible="True"/>
                        <field name="company_id" column_invisible="True"/>
                        <field name="product_id"/>
                        <field name="date_order"/>
                        <field name="purchase_order_id"/>
                        <field name="name"/>
                        <field name="product_uom_qty"/>
                        <field name="product_uom" optional="hide"/>
<!--                        <field name="product_uom_category_id" column_invisible="True"/>-->
                        <field name="price_unit"/>
                        <field name="taxes_id" widget="many2many_tags" optional="hide"/>
                        <field name="discount" column_invisible="True"/>
                        <field name="discount_amount" optional="hide"/>
                        <field name="price_subtotal" optional="show"/>
                        <field name="price_total" optional="show"/>
                        <field name="conversion_rate_pkr" optional="show"/>
                        <field name="amount_in_pkr" optional="show"/>
                    </list>
                </field>



                    <!--OVERALL PRODUCTS PURCHASE -->
                <group name="overall_purchase" string="TOTAL PURCHASE HISTORY" class="mt-0"></group>
                <field name="total_purchase_history" widget="section_and_note_one2many" readonly="1">
                    <list string="Products Line" editable="bottom">
                        <field name="currency_id" column_invisible="True"/>
                        <field name="company_id" column_invisible="True"/>
                        <field name="product_id"/>
                        <field name="date_order"/>
                        <field name="purchase_order_id"/>
                        <field name="partner_id"/>
                        <field name="name"/>
                        <field name="product_uom_qty"/>
                        <field name="product_uom" optional="hide"/>
<!--                        <field name="product_uom_category_id"/>-->
                        <field name="price_unit"/>
                        <field name="taxes_id" widget="many2many_tags" optional="hide"/>
                        <field name="discount" column_invisible="True"/>
                        <field name="discount_amount" optional="hide"/>
                        <field name="price_subtotal" optional="show"/>
                        <field name="price_total" optional="show"/>
                        <field name="conversion_rate_pkr" optional="show"/>
                        <field name="amount_in_pkr" optional="show"/>
                    </list>
                </field>


                <!--PRODUCT PARTS HISTORY -->
                <group name="product_parts_history" string="PRODUCT PARTS HISTORY" class="mt-0"></group>
                <field name="purchase_products_parts_history" widget="section_and_note_one2many" readonly="1">
                    <list string="Parts Line" editable="bottom">
                        <field name="product_part_id"/>
                        <field name="date_from"/>
                        <field name="date_to"/>
                        <field name="part_number"/>
                        <field name="engine_id"/>
                        <field name="engine_capacity"/>
                    </list>
                </field>

            </xpath>
        </field>
    </record>
</odoo>
